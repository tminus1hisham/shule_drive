<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Transfa</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>transfa</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>tel</string>
		<string>mailto</string>
	</array>

	<!-- Location: drivers share the bus position with parents during a trip,
	     including while the phone is locked (UIBackgroundModes location). -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Transfa uses your location to show the school bus on the map and, for drivers, to share the bus's live position with parents during a trip.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Drivers: Transfa keeps sharing the bus's live position with parents while a trip is running, even when the screen is locked or another app is open.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
		<string>fetch</string>
	</array>
	<!-- Must match the Workmanager task name in lib/services/offline_sync_manager.dart
	     and the identifier registered in AppDelegate.swift. -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>shuledrive_background_sync</string>
	</array>

	<!-- Camera and Photo Library Permissions -->
	<key>NSCameraUsageDescription</key>
	<string>Transfa uses the camera so you can take a profile photo for yourself or your child.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Transfa needs access to your photos so you can choose a profile photo for yourself or your child.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Transfa saves photos you take to your photo library.</string>
</dict>
</plist>
