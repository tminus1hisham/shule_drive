# ShuleDrive Environment Configuration
# Copy this file to .env and add your actual values
# DO NOT commit .env to version control - it's already in .gitignore!

# ============================================================================
# REQUIRED: Mapbox Configuration
# ============================================================================
# Get your token at: https://account.mapbox.com/access-tokens/
# Use a PUBLIC token (starts with pk.), NOT a secret token (starts with sk.)
MAPBOX_ACCESS_TOKEN=pk.your_mapbox_token_here

# Legacy support: You can also use ACCESS_TOKEN, but MAPBOX_ACCESS_TOKEN is preferred
# ACCESS_TOKEN=pk.your_mapbox_token_here

# ============================================================================
# OPTIONAL: Environment Configuration
# ============================================================================
# Environment type: development, staging, or production
# Defaults to: development (debug builds) or production (release builds)
ENVIRONMENT=development

# API Base URL
# Defaults to: https://staging-api.shuledrive.com (non-production)
# API_BASE_URL=https://staging-api.shuledrive.com
# API_BASE_URL=https://api.shuledrive.com
